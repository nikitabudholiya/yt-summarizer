{
  "manifest_version": 3,
  "name": "YT Summarizer",
  "version": "1.0.0",
  "description": "Summarize any YouTube video with AI — powered by Groq.",

  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js":      ["content.js"],
      "run_at":  "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "host_permissions": [
    "http://localhost:8000/*"
  ]
}
